# Root-level helper.
# Actual backend runtime env lives in backend/.env
# Copy template:
#   copy backend\.env.example backend\.env
# FastAPI
APP_TITLE=Система знаний команды
API_HOST=127.0.0.1
API_PORT=8000

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_LOOPBACK=http://127.0.0.1:5173

# SQLite (default local DB file)
DATABASE_URL=sqlite:///./team_memory.db

# OpenAI-compatible provider
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name
PINECONE_NAMESPACE=default
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval tuning
VECTOR_TOP_K=6
KEYWORD_TOP_K=6
HYBRID_TOP_K=6
COSINE_SIMILARITY_THRESHOLD=0.85
DEDUP_BATCH_LIMIT=30
